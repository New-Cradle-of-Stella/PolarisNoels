<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>PolarisNoels</AssemblyName>
    <Product>PolarisNoels</Product>
    <Version>1.0.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
    </RestoreAdditionalProjectSources>
    <RootNamespace>PolarisNoels</RootNamespace>
    <OutputPath Condition="'$(GameRootPath)' != ''">$(GameRootPath)\BepInEx\plugins\PolarisNoels</OutputPath>
    <OutputPath Condition="'$(GameRootPath)' == ''">$(MSBuildProjectDirectory)\.build\plugin</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
	<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <PropertyGroup>
    <PolarisCoreDir Condition="'$(PolarisCoreDir)' == ''">$(MSBuildProjectDirectory)\..\Polaris\Core\bin\Debug\netstandard2.1</PolarisCoreDir>
  </PropertyGroup>

  <PropertyGroup>
	<GameAssembliesPath>$(GameRootPath)\AliceInCradle_Data\Managed</GameAssembliesPath>
  </PropertyGroup>
    
  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Unity.Mono" Version="6.0.0-be.*" IncludeAssets="compile" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="protobuf-net" Version="2.4.9" />
    <PackageReference Include="System.Reflection" Version="4.3.0" />
    <PackageReference Include="UnityEngine.Modules" Version="2022.3.62" IncludeAssets="compile" />
    <PackageReference Include="Krafs.Publicizer" Version="2.3.0" PrivateAssets="all" />
  </ItemGroup>
  
  <ItemGroup>
    <Publicize Include="Assembly-CSharp" />
    <Publicize Include="unsafeAssem" />
    <Publicize Include="ttr" />
  </ItemGroup>

  <!-- 随插件一起复制到输出目录的资源：素材与各语言的本地化文本 -->
  <ItemGroup>
    <None Update="pics\**;pxls\**;resources\**;_\**;en\**;ko-kr\**;th\**;zh-cn\**;zh-tc\**">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    原生传输 DLL（Rust）：native/polaris_net/target/release/polaris_net.dll。
    缺失时给出可诊断的构建告警（插件本体照常编译，运行时联机功能自动禁用）；
    设 RequireNativeTransport=true 可把它升级为构建错误。
  -->
  <PropertyGroup>
    <NativeTransportPath>$(MSBuildProjectDirectory)\native\polaris_net\target\release\polaris_net.dll</NativeTransportPath>
    <RequireNativeTransport Condition="'$(RequireNativeTransport)' == ''">false</RequireNativeTransport>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(NativeTransportPath)" Link="polaris_net.dll" Condition="Exists('$(NativeTransportPath)')" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyNativeTransport" AfterTargets="Build">
    <Warning Condition="!Exists('$(NativeTransportPath)') And '$(RequireNativeTransport)' != 'true'"
             Text="polaris_net.dll 尚未构建（$(NativeTransportPath) 不存在）：联机功能将在运行时被禁用、单机不受影响。请在 native/polaris_net 执行 cargo build --release（x86_64-pc-windows-msvc）。" />
    <Error Condition="!Exists('$(NativeTransportPath)') And '$(RequireNativeTransport)' == 'true'"
           Text="缺少原生传输库 $(NativeTransportPath)：请先构建 native/polaris_net（cargo build --release）。" />
    <Copy Condition="Exists('$(NativeTransportPath)')" SourceFiles="$(NativeTransportPath)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
    <Message Condition="Exists('$(NativeTransportPath)')" Importance="high" Text="已复制原生传输库到 $(OutputPath)" />
  </Target>

  <ItemGroup>
    <!-- Polaris 核心库：编译期引用，运行时由 [BepInDependency("Polaris.Core")] 保证先加载。 -->
    <Reference Include="PolarisCore">
      <HintPath>$(PolarisCoreDir)\PolarisCore.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>D:\ZzqoQrtW_AliceInCradle Win ver030i\AliceInCradle Win ver030\AliceInCradle_ver030\AliceInCradle_Data\Managed\Assembly-CSharp.dll</HintPath>
    </Reference>
    <Reference Include="pixelliner">
      <HintPath>D:\ZzqoQrtW_AliceInCradle Win ver030i\AliceInCradle Win ver030\AliceInCradle_ver030\AliceInCradle_Data\Managed\pixelliner.dll</HintPath>
    </Reference>
    <Reference Include="unsafeAssem">
      <HintPath>D:\ZzqoQrtW_AliceInCradle Win ver030i\AliceInCradle Win ver030\AliceInCradle_ver030\AliceInCradle_Data\Managed\unsafeAssem.dll</HintPath>
    </Reference>
    <Reference Include="better">
      <HintPath>D:\ZzqoQrtW_AliceInCradle Win ver030i\AliceInCradle Win ver030\AliceInCradle_ver030\AliceInCradle_Data\Managed\better.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
