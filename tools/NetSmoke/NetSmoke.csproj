<Project Sdk="Microsoft.NET.Sdk">

  <!--
    独立 .NET 冒烟程序：只链接 NativeMethods/NativeTransport/INetTransport 源文件，
    不引用任何 Unity / 游戏程序集。这样它能验证“传输层真的与游戏无关”。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>NetSmoke</AssemblyName>
    <RootNamespace>PolarisNoels.NetSmoke</RootNamespace>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="..\..\Networking\INetTransport.cs" Link="Linked\INetTransport.cs" />
    <Compile Include="..\..\Networking\NativeMethods.cs" Link="Linked\NativeMethods.cs" />
    <Compile Include="..\..\Networking\NativeTransport.cs" Link="Linked\NativeTransport.cs" />
    <Compile Include="..\..\Networking\ReliableSendQueue.cs" Link="Linked\ReliableSendQueue.cs" />
    <Compile Include="..\..\Networking\SafeEvents.cs" Link="Linked\SafeEvents.cs" />
  </ItemGroup>

</Project>
