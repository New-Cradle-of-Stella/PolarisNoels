<Project Sdk="Microsoft.NET.Sdk">

  <!--
    独立 managed 会话集成测试：源链接真实的 NetworkRuntime / HostSession / ClientSession /
    HandshakeCodec / BulkCodec / SaveTransfer，只为游戏/Unity/BepInEx/DB 依赖提供测试 stub。
    不引用任何 Unity / 游戏程序集，不加载 polaris_net.dll。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>SessionSmoke</AssemblyName>
    <RootNamespace>PolarisNoels.SessionSmoke</RootNamespace>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- FakeTransport 故意实现全部事件；未被触发的少数事件不应产生噪声。 -->
    <NoWarn>$(NoWarn);CS0067</NoWarn>
  </PropertyGroup>

  <!--
    Newtonsoft.Json 用本机 NuGet 缓存里的明确路径（13.0.4），避免 restore 联网安装依赖。
    缓存缺失时回退到仓库 .build/plugin 里已有的同版本程序集。
  -->
  <PropertyGroup>
    <NewtonsoftLib>$(USERPROFILE)\.nuget\packages\newtonsoft.json\13.0.4\lib\net6.0\Newtonsoft.Json.dll</NewtonsoftLib>
    <NewtonsoftLib Condition="!Exists('$(NewtonsoftLib)')">$(MSBuildThisFileDirectory)..\..\.build\plugin\Newtonsoft.Json.dll</NewtonsoftLib>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="..\..\Networking\INetTransport.cs" Link="Linked\INetTransport.cs" />
    <Compile Include="..\..\Networking\NetworkRuntime.cs" Link="Linked\NetworkRuntime.cs" />
    <Compile Include="..\..\Networking\BulkCodec.cs" Link="Linked\BulkCodec.cs" />
    <Compile Include="..\..\Networking\SaveTransfer.cs" Link="Linked\SaveTransfer.cs" />
    <Compile Include="..\..\Networking\NativeMethods.cs" Link="Linked\NativeMethods.cs" />
    <Compile Include="..\..\Networking\NativeTransport.cs" Link="Linked\NativeTransport.cs" />
    <Compile Include="..\..\Networking\ReliableSendQueue.cs" Link="Linked\ReliableSendQueue.cs" />
    <Compile Include="..\..\Networking\SafeEvents.cs" Link="Linked\SafeEvents.cs" />
    <Compile Include="..\..\Networking\Session\ClientSession.cs" Link="Linked\ClientSession.cs" />
    <Compile Include="..\..\Networking\Session\HostSession.cs" Link="Linked\HostSession.cs" />
    <Compile Include="..\..\Networking\ClientServer\HandshakeCodec.cs" Link="Linked\HandshakeCodec.cs" />
    <Compile Include="..\..\Networking\ClientServer\PolarisNoelsHostMessage.cs" Link="Linked\PolarisNoelsHostMessage.cs" />
    <Compile Include="..\..\Networking\ClientServer\PolarisNoelsClientMessage.cs" Link="Linked\PolarisNoelsClientMessage.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(NewtonsoftLib)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
